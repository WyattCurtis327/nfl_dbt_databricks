# Copy this file to .env and fill in the values. .env is gitignored.
# dbt 1.12 and the VS Code extension load .env from this folder.
# DBT_ENV_SECRET_* is scrubbed from dbt logs. dbt allows that prefix only in profiles.yml.
# DBT_HOST and DBT_HTTP_PATH are the same host and path. The Databricks dbt task
# injects DBT_HOST and DBT_ACCESS_TOKEN. Set DBT_HTTP_PATH on that job yourself.
# The Databricks CLI reads the workspace URL from the profile named in
# DATABRICKS_CONFIG_PROFILE, not from databricks.yml.

DBT_ENV_SECRET_HOST=your-workspace.cloud.databricks.com
DBT_ENV_SECRET_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
DBT_HOST=your-workspace.cloud.databricks.com
DBT_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
DATABRICKS_CONFIG_PROFILE=your-databricks-cli-profile
DBT_CLOUD_HOST=your-account.us1.dbt.com
DBT_CLOUD_ACCOUNT_NAME=your-dbt-account
DBT_CLOUD_PROJECT_ID=
DBT_CLOUD_DEFER_ENV_ID=
DBT_CLOUD_DEV_ENV_ID=
DBT_CLOUD_JOB_ID=
